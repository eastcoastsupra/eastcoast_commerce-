{
  "name": "eastcoast-commerce-turn14-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Controlled Turn 14 MAP pricing sync for East Coast Supra and East Coast BMW Wix stores.",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "check": "node scripts/check-syntax.js",
    "test": "node --test test/*.test.js",
    "validate": "npm run check && npm test",
    "sync": "node src/cli.js",
    "dry-run:chemical-guys": "node src/cli.js --brand \"Chemical Guys\" --site all",
    "apply:chemical-guys": "node src/cli.js --brand \"Chemical Guys\" --site all --apply"
  }
}
