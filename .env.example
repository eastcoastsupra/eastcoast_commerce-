# Turn 14 OAuth client credentials. Never commit real values.
TURN14_CLIENT_ID=
TURN14_CLIENT_SECRET=
TURN14_BASE_URL=https://api.turn14.com

# Wix API key authorized to read and manage store products on both sites.
WIX_API_KEY=

# Optional runtime controls.
HTTP_TIMEOUT_MS=30000
HTTP_RETRIES=3
HTTP_RETRY_BASE_MS=750
TURN14_PAGE_CONCURRENCY=4
REPORTS_DIR=reports
